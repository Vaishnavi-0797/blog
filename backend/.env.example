# Copy this file to ".env" and fill in your own values.
PORT=5000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=blog_platform_db

# Use a long random text. Never share it or upload .env to GitHub.
JWT_SECRET=change_this_to_a_long_random_secret_text
JWT_EXPIRES_IN=7d
